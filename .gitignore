# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editor backup/temp files. JetBrains writes .idea/workspace.xml~ and holds a lock on it;
# Tailwind v4's content scanner walks everything not gitignored, so without this it reads a
# locked file and Turbopack panics mid-build.
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# training pipeline (training/README.md) - reproducible from download_data.py, not committed
/scratchpad_train_venv/
/training/data/
__pycache__/
*.pyc

# candidate model artifacts - training/train.py writes here; promoted to model.json/*.bin
# manually per training/README.md, never committed as _candidate_*
/public/model/_candidate_tfjs/
/public/model/_candidate_report.json
/public/model/_candidate_checkpoint.weights.h5
/public/model/_candidate_checkpoint.epoch

# per-run training logs (training/train_run*.log) - local scratch, not reproducible artifacts
/training/train_run*.log
