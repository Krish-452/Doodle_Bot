# Copy to .env.local and fill in. .env* is gitignored; this example file is not.
#
# The anon key is public by design — it ships in the client bundle and RLS is what protects
# the data. The service_role key must never appear here, in .env.local, or in any
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL= https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY= your_publishable_key_here